      ],
      "depends_on": [
        "model.marketplace_dwh.stg_sales"
      ],
      "original_file_path": "models\\marts\\fct_sales.sql",
      "raw_code": "{{ config(\r\n    materialized='incremental',\r\n    unique_key=['invoice_no', 'stock_code', 'order_date', 'customer_id']\r\n) }}\r\n\r\nSELECT\r\n    invoice_no,\r\n    stock_code,\r\n    date_id AS order_date,\r\n    customer_id,\r\n    SUM(quantity) AS total_quantity,\r\n    SUM(total_amount) AS total_revenue\r\nFROM {{ ref('stg_sales') }}\r\nGROUP BY \r\n    invoice_no, \r\n    stock_code, \r\n    date_id, \r\n    customer_id"
    },
    {
      "unique_id": "model.marketplace_dwh.mart_sales_funnel",
      "name": "mart_sales_funnel",
      "resource_type": "model",
      "database": "dwh_marketplace",
      "schema": "dbt_schema",
      "materialized": "table",
      "description": "",
      "owner": "pavel.onishchenko",
      "tags": [
        "analytics"
      ],
      "layer": "analytics",
      "columns": [],
      "depends_on": [],
      "original_file_path": "models\\marts\\mart_sales_funnel.sql",
      "raw_code": "{{ config(materialized='table') }}\r\n\r\nWITH orders AS (\r\n    SELECT\r\n        invoice_no,\r\n        MIN(order_date) AS first_order_date,\r\n        SUM(total_revenue) AS total_revenue,\r\n        COUNT(DISTINCT stock_code) AS total_items\r\n    FROM dbt_schema.fct_sales\r\n    GROUP BY invoice_no\r\n)\r\n\r\nSELECT\r\n    first_order_date AS order_date,\r\n    COUNT(DISTINCT invoice_no) AS total_orders,\r\n    SUM(CASE WHEN total_revenue > 0 THEN 1 ELSE 0 END) AS paid_orders,\r\n    SUM(CASE WHEN total_revenue = 0 THEN 1 ELSE 0 END) AS cancelled_orders,\r\n    ROUND(\r\n        SUM(CASE WHEN total_revenue > 0 THEN 1 ELSE 0 END)::numeric / \r\n        NULLIF(COUNT(DISTINCT invoice_no), 0) * 100, 2\r\n    ) AS conversion_rate_percent,\r\n    SUM(total_revenue) AS total_revenue\r\nFROM orders\r\nGROUP BY first_order_date\r\nORDER BY first_order_date"
    },
